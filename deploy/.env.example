SERVER_PORT=8080
MUSIC_LIBRARY_HOST_DIR=./music
DATA_DIR=./data
SERVER_MEMORY_LIMIT=256m
SERVER_MEMORY_RESERVATION=128m
GOMEMLIMIT=192MiB
GOGC=100
LOG_LEVEL=info
AUTH_SESSION_TTL=24h

# 自定义在线歌词源（HisAtri/LrcApi 兼容服务，可选）。
# LRCAPI_BASE_URL 留空则禁用在线歌词；填写后当本地无 .lrc 也无内嵌歌词时，
# 服务端会按标题/歌手调用 LrcApi 获取标准 LRC 歌词并缓存到内存。
# 示例：LRCAPI_BASE_URL=http://lrcapi:1122
LRCAPI_BASE_URL=
LRCAPI_AUTH_KEY=
LRCAPI_TIMEOUT=10s
